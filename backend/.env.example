# LLM Provider Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
PRIMARY_LLM_PROVIDER=gemini

# MongoDB Atlas / Local Database Configuration
# Cloud Atlas URI format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local fallback format:  mongodb://127.0.0.1:27017
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=phishguard_ai

# JWT Authentication & Session Security
JWT_SECRET=replace-with-a-very-strong-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_NAME=phishguard_session
COOKIE_SECURE=false  # Set to true in production HTTPS
COOKIE_SAMESITE=lax

# Application Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
MAX_UPLOAD_BYTES=10485760  # 10 MB bounded limit
REQUEST_TIMEOUT_SECONDS=30

